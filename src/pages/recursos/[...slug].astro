---
import { getCollection } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  try {
    const tutorialEntries = await getCollection('recursos');
    return tutorialEntries.map(entry => ({
      params: { slug: entry.slug }, props: { entry },
    }));
  } catch (e) {
    return [];
  }
}

const { entry } = Astro.props;
if (!entry) {
    return Astro.redirect('/404');
}
const { Content, headings } = await entry.render();

const toc = headings.filter(h => h.depth === 2 || h.depth === 3);

const getDifficultyClass = (diff: string) => {
  if (diff === 'Principiante') return 'diff-principiante';
  if (diff === 'Intermedio') return 'diff-intermedio';
  if (diff === 'Avanzado') return 'diff-avanzado';
  if (diff === 'Experto') return 'diff-experto';
  return 'diff-default';
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": entry.data.title,
      "description": entry.data.description,
      "author": {
        "@type": "Person",
        "name": entry.data.author || "Zorzal RF"
      },
      "datePublished": new Date(entry.data.publishDate).toISOString(),
      "image": entry.data.image ? new URL(entry.data.image, Astro.site || Astro.url.origin).toString() : new URL('/og-image.webp', Astro.site || Astro.url.origin).toString(),
      "url": Astro.url.href
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": new URL('/', Astro.site || Astro.url.origin).toString()
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Recursos",
          "item": new URL('/recursos/', Astro.site || Astro.url.origin).toString()
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": entry.data.title,
          "item": Astro.url.href
        }
      ]
    }
  ]
};
---

<DocsLayout title={entry.data.title} description={entry.data.description} type="article" schema={schema}>
  <article class="tutorial-content">
    <header>
      <div class="tags-row">
        <span class={`difficulty-badge ${getDifficultyClass(entry.data.difficulty)}`}>
          {entry.data.difficulty}
        </span>
        <span class="reading-time">⏱️ {entry.data.readingTime} min</span>
        <span class="category-tag">{entry.data.category}</span>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="description">{entry.data.description}</p>
      <div class="meta">
        <span>Ultima actualización: {new Date(entry.data.publishDate).toLocaleDateString('es-AR')}</span>
        <span>Por {entry.data.author}</span>
      </div>
    </header>
    
    <div class="prose">
      {toc.length > 0 && (
        <div class="toc-container">
          <div class="toc-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path></svg>
            En este artículo
          </div>
          <ul class="toc-list">
            {toc.map(heading => (
              <li class={`toc-depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <Content />
      
      <div class="article-cta">
        <div class="cta-content">
          <h3>¿Listo para arrancar con tu proyecto?</h3>
          <p>En nuestra tienda oficial vas a encontrar los receptores RTL-SDR, antenas y accesorios que necesitas, con envío a todo el país.</p>
        </div>
        <a href="https://zorzalrf.empretienda.com.ar" target="_blank" rel="noopener noreferrer" class="cta-button">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          Ir a la Tienda
        </a>
      </div>
    </div>
  </article>
</DocsLayout>

<style>
  .tutorial-content {
    max-width: 800px;
    margin: 0 auto;
  }
  
  header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  
  h1 {
    font-size: 2.5rem;
    color: var(--color-orange);
    margin-bottom: 0.5rem;
  }
  
  .tags-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .difficulty-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-size: 0.8rem;
    font-weight: bold;
    border: 1px solid transparent;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .diff-principiante {
    background-color: rgba(74, 222, 128, 0.15);
    color: #166534;
    border-color: rgba(74, 222, 128, 0.4);
  }
  .diff-intermedio {
    background-color: rgba(250, 204, 21, 0.15);
    color: #854d0e;
    border-color: rgba(250, 204, 21, 0.4);
  }
  .diff-avanzado {
    background-color: rgba(249, 115, 22, 0.15);
    color: #9a3412;
    border-color: rgba(249, 115, 22, 0.4);
  }
  .diff-experto {
    background-color: rgba(239, 68, 68, 0.15);
    color: #991b1b;
    border-color: rgba(239, 68, 68, 0.4);
  }
  .diff-default {
    background-color: rgba(156, 163, 175, 0.15);
    color: #374151;
    border-color: rgba(156, 163, 175, 0.4);
  }

  :global(.theme-dark) .diff-principiante {
    background-color: rgba(74, 222, 128, 0.1);
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.3);
  }
  :global(.theme-dark) .diff-intermedio {
    background-color: rgba(250, 204, 21, 0.1);
    color: #facc15;
    border-color: rgba(250, 204, 21, 0.3);
  }
  :global(.theme-dark) .diff-avanzado {
    background-color: rgba(249, 115, 22, 0.1);
    color: #f97316;
    border-color: rgba(249, 115, 22, 0.3);
  }
  :global(.theme-dark) .diff-experto {
    background-color: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.3);
  }
  :global(.theme-dark) .diff-default {
    background-color: rgba(156, 163, 175, 0.1);
    color: #9ca3af;
    border-color: rgba(156, 163, 175, 0.3);
  }

  .reading-time {
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .category-tag {
    background-color: var(--color-border);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    color: var(--color-text);
    font-size: 0.8rem;
    font-weight: bold;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .description {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
  
  .meta {
    display: flex;
    gap: 2rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  
  /* Styling for the markdown content */
  .prose {
    line-height: 1.8;
    font-size: 1.1rem;
    color: var(--color-text);
  }
  
  .prose :global(h2) {
    color: var(--color-heading);
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 100px;
  }
  
  .prose :global(h3) {
    color: var(--color-heading);
    font-size: 1.4rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 100px;
  }
  
  /* Table of Contents */
  .toc-container {
    margin: 0.5rem 0 2rem 0;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  
  .toc-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .toc-title svg {
    display: none;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .toc-list li {
    display: flex;
    align-items: baseline;
  }
  
  .toc-list li::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    background-color: var(--color-orange);
    border-radius: 50%;
    margin-right: 0.75rem;
    opacity: 0.3;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .toc-list li:hover::before {
    opacity: 1;
    transform: scale(1.5);
  }
  
  .toc-list li a {
    color: var(--color-text) !important;
    text-decoration: none;
    transition: color 0.2s ease;
    font-size: 1.05rem;
    line-height: 1.4;
  }
  
  .toc-list li a:hover {
    color: var(--color-orange) !important;
  }
  
  .toc-depth-2 {
    font-weight: 500;
  }
  
  .toc-depth-3 {
    margin-left: 1.5rem;
  }
  
  .toc-depth-3::before {
    width: 4px;
    height: 4px;
    background-color: var(--color-text-muted);
    opacity: 0.5;
  }
  
  .prose :global(a) {
    color: var(--color-orange);
  }
  
  .prose :global(code) {
    background: var(--color-code-bg);
    padding: 0.2em 0.4em;
    border-radius: 3px;
    font-family: monospace;
    font-size: 0.9em;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  
  .prose :global(pre) {
    background: var(--color-code-bg);
    padding: 1.5rem;
    border-radius: 8px;
    overflow-x: auto;
    border: 1px solid var(--color-border);
  }
  
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.95rem;
    background: var(--color-card-bg);
    border-radius: 8px;
    display: block;
    overflow-x: auto;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }

  .prose :global(th) {
    background-color: rgba(255, 140, 0, 0.1);
    color: var(--color-heading);
    font-weight: 700;
    text-align: left;
    padding: 1rem;
    border-bottom: 2px solid var(--color-orange);
  }

  .prose :global(td) {
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    vertical-align: top;
  }

  .prose :global(tr:last-child td) {
    border-bottom: none;
  }

  .prose :global(tr:hover td) {
    background-color: var(--color-code-bg);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    margin: 2rem auto;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }

  .prose :global(.attribution) {
    background: linear-gradient(to right, rgba(255, 140, 0, 0.08), transparent);
    border-left: 4px solid var(--color-orange);
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0 2.5rem 0;
    border-radius: 0 8px 8px 0;
    display: flex;
    gap: 1rem;
    align-items: center;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  
  .prose :global(.attribution svg) {
    flex-shrink: 0;
    color: var(--color-orange);
  }

  .prose :global(.attribution p) {
    margin: 0;
    line-height: 1.6;
  }

  .prose :global(.attribution strong) {
    color: var(--color-heading);
  }

  /* End of Article CTA */
  .article-cta {
    margin-top: 3rem;
    padding: 2rem;
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-orange);
    border-radius: 4px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .cta-content h3 {
    margin: 0 0 0.5rem 0;
    color: var(--color-heading);
    font-size: 1.3rem;
  }

  .cta-content p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .cta-button {
    flex-shrink: 0;
    background-color: var(--color-orange) !important;
    color: white !important;
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  .cta-button:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
    color: white !important;
  }

  @media (max-width: 768px) {
    .article-cta {
      flex-direction: column;
      text-align: left;
      padding: 1.5rem;
      gap: 1.5rem;
    }
    
    .cta-button {
      width: 100%;
    }
  }
</style>
