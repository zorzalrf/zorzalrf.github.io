---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { catalogoItems } from '../data/catalogo';

const featuredItems = catalogoItems.filter(i => 
  i.title.includes("Kit RTL-SDR Blog V3 + Antena Dipolo") || 
  i.title.includes("Kit ADS-B 1090 MHz Profesional") || 
  i.title.includes("Receptor RTL-SDR Blog V3 - HF/VHF/UHF")
).slice(0, 3);

const indexSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": featuredItems.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Product",
      "name": item.title,
      "image": [new URL('/og-image.webp', Astro.site || Astro.url.origin).toString()],
      "description": item.specs.join('. '),
      "url": item.url || Astro.url.href,
      "brand": {
        "@type": "Brand",
        "name": "Zorzal RF"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5",
        "reviewCount": "1"
      },
      "review": {
        "@type": "Review",
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": "5",
          "bestRating": "5"
        },
        "author": {
          "@type": "Person",
          "name": "Cliente Zorzal RF"
        }
      },
      "offers": {
        "@type": "Offer",
        "price": item.price || 0,
        "priceCurrency": "ARS",
        "availability": item.category === 'Sin Stock' ? "https://schema.org/OutOfStock" : "https://schema.org/InStock",
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "AR",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 30,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn"
        },
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": {
            "@type": "MonetaryAmount",
            "value": "0.00",
            "currency": "ARS"
          },
          "shippingDestination": {
            "@type": "DefinedRegion",
            "addressCountry": "AR"
          },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": {
              "@type": "QuantitativeValue",
              "minValue": 0,
              "maxValue": 1,
              "unitCode": "DAY"
            },
            "transitTime": {
              "@type": "QuantitativeValue",
              "minValue": 1,
              "maxValue": 5,
              "unitCode": "DAY"
            }
          }
        }
      }
    }
  }))
};
---

<Layout title="Inicio - Especialistas en SDR y RF" description="Especialistas en Radio Definida por Software (SDR) y sistemas de RF. Hardware testeado, antenas y kits completos para recepción de alta performance." schema={indexSchema}>
  <section class="hero">
    <h1>Componentes y Soluciones para Recepción de Alta Performance</h1>
    <p>Nos especializamos en Radio Definida por Software (SDR) y sistemas de RF especializados.</p>
    <p class="authority-text">Hardware original, seleccionado y testeado.</p>
    <div class="cta-group">
      <a href={import.meta.env.BASE_URL + 'catalogo/'} class="button primary">Ver Catálogo</a>
    <a href={import.meta.env.BASE_URL + 'recursos/'} class="button secondary">Ir al Centro de Recursos</a>
    </div>
  </section>

  <section class="featured">
    <h2>Equipos Destacados</h2>
    <div class="product-grid">
      <ProductCard 
        title="Kit RTL-SDR Blog V3 + Antena Dipolo - SDR Completo"
        category="Entrega Inmediata" 
        specs={["Tuner R860 (R820T2) con oscilador TCXO de 1 PPM", "Compatible con SDRSharp, GQRX y HDSDR", "Circuito Bias-Tee conmutable vía software", "Protección ESD adicional y bajo nivel de ruido", "Incluye base dipolo, cables y soportes"]} 
        idealUse="Kit completo para iniciarse en radioescucha."
        type={["SDR", "Antenas"]}
        isHero={true}
        badge="RECOMENDADO PARA PRINCIPIANTES"
        url="https://zorzalrf.empretienda.com.ar/antenas/kit-rtl-sdr-blog-v3-antena-dipolo-sdr-completo"
      />
      <ProductCard
        title="Kit ADS-B 1090 MHz Profesional: Antena + Filtro + Cable"
        category="Entrega Inmediata"
        type={["Antenas", "Filtros", "Accesorios"]}
        specs={[
          "Antena exterior 5.5 dBi con conector tipo N",
          "Filtro SAW pasabanda 1090 MHz",
          "Cable coaxial KMR-240 de bajas pérdidas",
          "Pigtails y adaptadores incluidos",
          "Mejora el alcance de tu receptor en hasta un 300%"
        ]}
        idealUse="Kit integral para montar tu propio radar de aviones."
        url="https://zorzalrf.empretienda.com.ar/antenas/estacion-ads-b-zorzal-rf-antena-cable-filtro"
      />
      <ProductCard
        title="Receptor RTL-SDR Blog V3 - HF/VHF/UHF TCXO 1PPM"
        type={["SDR"]}
        specs={[
          "Tuner R860 (R820T2) con oscilador TCXO de 1 PPM",
          "Compatible con SDRSharp, GQRX y HDSDR",
          "Muestreo directo integrado para recepción HF básica",
          "Carcasa metálica blindada para reducción de ruido",
          "Circuito Bias-Tee interno para alimentación de accesorios"
        ]}
        idealUse="Receptor SDR versátil de excelente valor."
        category="Entrega Inmediata"
        url="https://zorzalrf.empretienda.com.ar/sdrs/receptor-rtl-sdr-blog-v3-hfvhfuhf"
      />
    </div>
    
    <div class="category-links">
      <p>Explorá más productos por categoría: 
        <a href={import.meta.env.BASE_URL + 'catalogo/sdr/'}>Receptores SDR</a> | 
        <a href={import.meta.env.BASE_URL + 'catalogo/antenas/'}>Antenas y Cables</a> | 
        <a href={import.meta.env.BASE_URL + 'catalogo/filtros/'}>Filtros RF</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 4rem 0;
    margin-bottom: 3rem;
  }
  
  .hero h1 {
    font-size: 3rem;
    color: var(--color-orange);
    margin-bottom: 1rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: normal;
  }
  
  .hero p {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    max-width: 800px;
    margin: 0 auto 1.5rem;
  }

  .authority-text {
    font-size: 1rem;
    color: var(--color-text);
    font-weight: 500;
    margin-bottom: 2rem;
  }
  
  .cta-group {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
  
  .button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    font-weight: bold;
    text-decoration: none;
    transition: all 0.2s;
  }
  
  .button.primary {
    background-color: var(--color-orange);
    color: var(--color-dark-gray);
  }
  
  .button.primary:hover {
    background-color: #e67e00;
  }
  
  .button.secondary {
    background-color: transparent;
    color: var(--color-orange);
    border: 2px solid var(--color-orange);
  }
  
  .button.secondary:hover {
    background-color: rgba(255, 140, 0, 0.1);
  }
  
  .featured h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.5rem;
  }
  
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }
  
  .category-links {
    text-align: center;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px dashed var(--color-border);
  }
  
  .category-links p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }
  
  .category-links a {
    color: var(--color-orange);
    text-decoration: none;
    font-weight: 500;
    margin: 0 0.5rem;
    transition: color 0.2s;
  }
  
  .category-links a:hover {
    color: var(--color-heading);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 0.5rem 0 2rem;
      margin-bottom: 2rem;
    }
    .hero h1 {
      font-size: 2.25rem;
    }
    .hero p {
      font-size: 1.1rem;
    }
    .cta-group {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
